{
  "name": "grudge-vault",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first event memory and evidence vault.",
  "author": "Grudge Vault contributors",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/prepare-native-media.mjs && electron-vite dev --config apps/desktop/electron.vite.config.ts --entry apps/desktop/out/main/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaging": "node --test scripts/package-runtime-identity.test.mjs scripts/verify-mac-zip.test.mjs",
    "test:live-smoke-budget": "node --test scripts/live-smoke-budget.test.mjs",
    "test:screening-kit": "node --test scripts/screening-kit.test.mjs",
    "prepare:screening-kit": "node scripts/prepare-screening-kit.mjs",
    "eval:screening": "node scripts/evaluate-screening.mjs",
    "test:e2e": "node scripts/prepare-native-media.mjs && electron-vite build --mode e2e --config apps/desktop/electron.vite.config.ts && playwright test",
    "build": "node scripts/prepare-native-media.mjs && electron-vite build --config apps/desktop/electron.vite.config.ts",
    "prepare:mac-media": "node scripts/prepare-native-media.mjs",
    "test:mac-media": "node scripts/test-native-media.mjs",
    "dist": "node scripts/prepare-package-assets.mjs && pnpm build && electron-builder --config electron-builder.yml",
    "dist:preview": "node scripts/prepare-package-assets.mjs && pnpm build && electron-builder --config electron-builder.preview.yml",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "mime-types": "3.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/mime-types": "2.1.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "43.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "30.0.1",
    "pnpm": "11.23.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
